// TikFlow — Phase 0 identity, tenancy, audit, security events.
// Row-Level Security is NOT expressed in this schema; see the
// hand-written migration SQL for ENABLE/FORCE RLS and policies.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_MIGRATE_URL")
  extensions = [pgcrypto, pg_trgm]
}

// ============================================================
// Enums
// ============================================================

enum TenantPlan {
  trial
  standard
  pro

  @@map("tenant_plan")
}

enum TenantStatus {
  active
  suspended
  closed

  @@map("tenant_status")
}

enum KycStatus {
  pending
  approved
  rejected

  @@map("kyc_status")
}

enum UserStatus {
  active
  invited
  suspended
  deleted

  @@map("user_status")
}

enum SecurityEventKind {
  login_success
  login_fail
  mfa_fail
  mfa_success
  password_reset
  password_change
  impossible_travel
  api_key_used
  export_data
  permission_change
  account_lockout

  @@map("security_event_kind")
}

enum SecurityEventSeverity {
  low
  medium
  high
  critical

  @@map("security_event_severity")
}

// ============================================================
// Tables
// ============================================================

model Tenant {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String       @unique
  country      String       @default("BD") @db.Char(2)
  currency     String       @default("BDT") @db.Char(3)
  timezone     String       @default("Asia/Dhaka")
  plan         TenantPlan   @default(trial)
  status       TenantStatus @default(active)
  billingEmail String?      @map("billing_email")
  kycStatus    KycStatus    @default(pending) @map("kyc_status")
  settings     Json         @default("{}")
  branding     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  users           User[]
  roles           Role[]
  apiKeys         ApiKey[]
  sessions        Session[]
  auditLogs       AuditLog[]
  securityEvents  SecurityEvent[]
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  zones           Zone[]
  servicePlans    ServicePlan[]
  subscribers     Subscriber[]
  subscriptions   Subscription[]
  inventoryItems  InventoryItem[]

  @@map("tenants")
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  email             String
  phone             String?
  passwordHash      String     @map("password_hash")
  mfaSecret         String?    @map("mfa_secret")
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  status            UserStatus @default(active)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  userRoles   UserRole[]
  sessions    Session[]
  auditEvents AuditLog[] @relation("AuditActor")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  tenantId     String   @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  label      String
  prefix     String
  hashedKey  String    @unique @map("hashed_key")
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, prefix])
  @@map("api_keys")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  jti       String    @unique
  ip        String?   @db.Inet
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  diff        Json?
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent")
  at          DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([tenantId, at(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SecurityEvent {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  kind      SecurityEventKind
  severity  SecurityEventSeverity @default(low)
  ip        String?               @db.Inet
  userAgent String?               @map("user_agent")
  payload   Json?
  at        DateTime              @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, at(sort: Desc)])
  @@index([kind, at(sort: Desc)])
  @@map("security_events")
}

// ============================================================
// Phase 2 — territory, catalogue, subscribers, inventory
// ============================================================

enum ServicePlanType {
  pppoe
  hotspot
  static
  wireless

  @@map("service_plan_type")
}

enum SubscriberStatus {
  pending
  active
  suspended
  cancelled

  @@map("subscriber_status")
}

enum ConnectionType {
  pppoe
  hotspot
  static

  @@map("connection_type")
}

enum SubscriptionStatus {
  pending
  active
  suspended
  cancelled

  @@map("subscription_status")
}

enum InventoryItemType {
  ont
  onu
  router
  switch
  splitter
  cable_drum
  nic
  antenna
  other

  @@map("inventory_item_type")
}

enum InventoryItemStatus {
  in_stock
  allocated
  deployed
  faulty
  returned
  scrapped

  @@map("inventory_item_status")
}

model Zone {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String
  slug        String
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  parent      Zone?        @relation("ZoneParent", fields: [parentId], references: [id])
  children    Zone[]       @relation("ZoneParent")
  subscribers Subscriber[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([parentId])
  @@map("zones")
}

model ServicePlan {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String          @map("tenant_id") @db.Uuid
  name                   String
  code                   String
  description            String?
  type                   ServicePlanType @default(pppoe)
  uploadKbps             Int             @map("upload_kbps")
  downloadKbps           Int             @map("download_kbps")
  burstUploadKbps        Int?            @map("burst_upload_kbps")
  burstDownloadKbps      Int?            @map("burst_download_kbps")
  burstThresholdUpload   Int?            @map("burst_threshold_upload")
  burstThresholdDownload Int?            @map("burst_threshold_download")
  burstTimeSeconds       Int?            @map("burst_time_seconds")
  validityDays           Int             @default(30) @map("validity_days")
  price                  Decimal         @db.Decimal(12, 2)
  vatPct                 Decimal         @default(0) @map("vat_pct") @db.Decimal(5, 2)
  fupLimitGb             Int?            @map("fup_limit_gb")
  fupThrottleKbps        Int?            @map("fup_throttle_kbps")
  mikrotikProfile        String?         @map("mikrotik_profile")
  queueName              String?         @map("queue_name")
  isActive               Boolean         @default(true) @map("is_active")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?       @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  subscriptions Subscription[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("service_plans")
}

model Subscriber {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  code             String
  fullName         String           @map("full_name")
  fullNameBn       String?          @map("full_name_bn")
  fatherName       String?          @map("father_name")
  nidNumber        String?          @map("nid_number")
  phone            String
  altPhone         String?          @map("alt_phone")
  email            String?
  address          String?
  addressBn        String?          @map("address_bn")
  zoneId           String?          @map("zone_id") @db.Uuid
  lat              Decimal?         @db.Decimal(9, 6)
  lng              Decimal?         @db.Decimal(9, 6)
  installationDate DateTime?        @map("installation_date") @db.Date
  status           SubscriberStatus @default(pending)
  connectionType   ConnectionType   @default(pppoe) @map("connection_type")
  notes            String?
  kycDocs          Json             @default("[]") @map("kyc_docs")
  createdBy        String?          @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  zone           Zone?           @relation(fields: [zoneId], references: [id])
  subscriptions  Subscription[]
  inventoryItems InventoryItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([zoneId])
  @@index([tenantId, status])
  @@map("subscribers")
}

model Subscription {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  subscriberId   String             @map("subscriber_id") @db.Uuid
  planId         String             @map("plan_id") @db.Uuid
  status         SubscriptionStatus @default(pending)
  activatedAt    DateTime?          @map("activated_at") @db.Timestamptz(6)
  paidUntil      DateTime?          @map("paid_until") @db.Timestamptz(6)
  nextInvoiceAt  DateTime?          @map("next_invoice_at") @db.Timestamptz(6)
  autoRenew      Boolean            @default(true) @map("auto_renew")
  suspendOnDue   Boolean            @default(true) @map("suspend_on_due")
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  subscriber Subscriber  @relation(fields: [subscriberId], references: [id])
  plan       ServicePlan @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([subscriberId])
  @@index([planId])
  @@index([tenantId, status])
  @@index([tenantId, paidUntil])
  @@map("subscriptions")
}

model InventoryItem {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  type          InventoryItemType
  status        InventoryItemStatus   @default(in_stock)
  serial        String?
  mac           String?
  vendor        String?
  model         String?
  location      String?
  subscriberId  String?               @map("subscriber_id") @db.Uuid
  purchasedAt   DateTime?             @map("purchased_at") @db.Date
  warrantyUntil DateTime?             @map("warranty_until") @db.Date
  cost          Decimal?              @db.Decimal(12, 2)
  notes         String?
  createdBy     String?               @map("created_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?             @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  subscriber Subscriber? @relation(fields: [subscriberId], references: [id])

  @@unique([tenantId, serial])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([subscriberId])
  @@map("inventory_items")
}
